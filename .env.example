# Pulao AI Environment Variables Template
# Copy to .env.local (never commit secrets)

# Server-Side Gemini API Key (used strictly inside server/geminiClient.ts; never exposed to browser)
GEMINI_API_KEY=

# Frontend Supabase Configuration (publishable client key governed by Row-Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional Evaluation Runner Settings
EVAL_TRIALS=3
PORT=3000
